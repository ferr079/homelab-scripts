#!/bin/bash
# pbs-backup — Orchestrate a full PBS backup cycle on a Wake-on-LAN node
#
# Flow: WOL backup host → wait boot → enable storage → vzdump every node →
#       wait → prune → GC → disable storage → shutdown
# Exit codes: 0=success, 1=partial (some backups failed), 2=critical (host unreachable)
#
# Usage: pbs-backup [--dry-run]
#
# Configuration lives in the environment, never in this file — see
# examples/homelab-scripts.env.example:
#
#   PBS_HOST_MAC, PBS_HOST_IP   the machine woken up and shut down
#   PBS_IP                      the PBS API endpoint (may be a CT on that host)
#   PBS_DATASTORE, PBS_PRUNE_JOB
#   PBS_STORAGE                 the PVE storage entry pointing at PBS
#   PVE_NODES                   one "name|host|api_token" per line
#   PVE_STORAGE_NODE            node used to toggle the storage entry (first by default)
#
# A maintained, fully generic version of this script lives in its own repo:
# https://github.com/ferr079/pbs-autobackup

set -uo pipefail

ENV_FILE="${HOMELAB_SCRIPTS_ENV:-$HOME/.config/homelab-scripts/homelab-scripts.env}"
if [ -r "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

: "${PBS_HOST_MAC:?PBS_HOST_MAC is required}"
: "${PBS_HOST_IP:?PBS_HOST_IP is required}"
: "${PBS_IP:?PBS_IP is required}"
: "${PVE_NODES:?PVE_NODES is required}"

PBS_STORAGE="${PBS_STORAGE:-pbs}"
PBS_DATASTORE="${PBS_DATASTORE:-}"
PBS_PRUNE_JOB="${PBS_PRUNE_JOB:-}"
BACKUP_MODE="${BACKUP_MODE:-snapshot}"
COMPRESS="${COMPRESS:-zstd}"
MAX_BOOT_WAIT="${MAX_BOOT_WAIT:-180}"   # seconds
MAX_TASK_WAIT="${MAX_TASK_WAIT:-3600}"  # seconds (1h max for all backups)
DRY_RUN=false

# First configured node drives the storage toggle unless told otherwise.
storage_node_host() {
  if [ -n "${PVE_STORAGE_NODE:-}" ]; then
    while IFS='|' read -r name host _token; do
      [ "$name" = "$PVE_STORAGE_NODE" ] && { echo "$host"; return; }
    done <<< "$PVE_NODES"
  fi
  head -n1 <<< "$PVE_NODES" | cut -d'|' -f2
}
storage_node_token() {
  if [ -n "${PVE_STORAGE_NODE:-}" ]; then
    while IFS='|' read -r name _host token; do
      [ "$name" = "$PVE_STORAGE_NODE" ] && { echo "$token"; return; }
    done <<< "$PVE_NODES"
  fi
  head -n1 <<< "$PVE_NODES" | cut -d'|' -f3
}
STORAGE_HOST="$(storage_node_host)"
STORAGE_TOKEN="$(storage_node_token)"

[ "${1:-}" = "--dry-run" ] && DRY_RUN=true

log() { echo "[$(date '+%H:%M:%S')] $*"; }
err() { echo "[$(date '+%H:%M:%S')] ERROR: $*" >&2; }

cleanup() {
  log "Cleanup: disabling PBS storage..."
  pve_api PUT "https://${STORAGE_HOST}:8006/api2/json/storage/${PBS_STORAGE}" "$STORAGE_TOKEN" "disable=1" > /dev/null 2>&1 || true
  log "Cleanup: shutting down the backup host..."
  ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no root@${PBS_HOST_IP} "shutdown -h now" 2>/dev/null || true
  log "Cleanup done."
}

pve_api() {
  local method="$1" url="$2" token="$3" data="${4:-}"
  if [ -n "$data" ]; then
    curl -sk -X "$method" "$url" -H "Authorization: PVEAPIToken=${token}" -d "$data" 2>/dev/null
  else
    curl -sk -X "$method" "$url" -H "Authorization: PVEAPIToken=${token}" 2>/dev/null
  fi
}

# --- Step 1: Wake the backup host ---
log "Step 1/7: Waking backup host (${PBS_HOST_MAC})..."
if $DRY_RUN; then
  log "[DRY-RUN] Would send WOL packet"
else
  wakeonlan "$PBS_HOST_MAC" > /dev/null 2>&1
fi

# --- Step 2: Wait for the backup host to boot ---
log "Step 2/7: Waiting for the backup host to boot (max ${MAX_BOOT_WAIT}s)..."
if ! $DRY_RUN; then
  elapsed=0
  while [ $elapsed -lt $MAX_BOOT_WAIT ]; do
    if ping -c 1 -W 2 "$PBS_HOST_IP" > /dev/null 2>&1; then
      log "backup host responding to ping after ${elapsed}s"
      # Extra wait for PBS service to start
      sleep 10
      # Verify the PBS API answers (it may run in a CT on that host)
      if curl -sk --max-time 5 "https://${PBS_IP}:8007/api2/json/version" > /dev/null 2>&1; then
        log "PBS API is up"
        break
      fi
    fi
    sleep 5
    elapsed=$((elapsed + 5))
  done

  if [ $elapsed -ge $MAX_BOOT_WAIT ]; then
    err "backup host did not boot within ${MAX_BOOT_WAIT}s"
    exit 2
  fi
fi

# --- Step 3: Enable PBS storage ---
log "Step 3/7: Enabling storage ${PBS_STORAGE}..."
if ! $DRY_RUN; then
  result=$(pve_api PUT "https://${STORAGE_HOST}:8006/api2/json/storage/${PBS_STORAGE}" "$STORAGE_TOKEN" "disable=0")
  if ! echo "$result" | python3 -c "import sys,json; json.load(sys.stdin)" > /dev/null 2>&1; then
    err "Failed to enable storage"
    cleanup
    exit 2
  fi
  log "Storage enabled"
  sleep 5  # Let PVE sync the storage config
fi

# --- Step 4+5: Run backups on pve1 and pve2 ---
task_ids=()
backup_ok=0
backup_fail=0

while IFS='|' read -r nname nip ntoken; do
  [ -z "${nname:-}" ] && continue
  log "Step 4/7: Starting backup on ${nname}..."

  if $DRY_RUN; then
    log "[DRY-RUN] Would start vzdump --all on ${nname}"
    continue
  fi

  result=$(pve_api POST "https://${nip}:8006/api2/json/nodes/${nname}/vzdump" "$ntoken" "all=1&storage=${PBS_STORAGE}&mode=${BACKUP_MODE}&compress=${COMPRESS}&prune-backups=keep-weekly%3D5%2Ckeep-last%3D1")
  upid=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin)['data'])" 2>/dev/null) || true

  if [ -z "$upid" ]; then
    err "Failed to start backup on ${nname}: $result"
    backup_fail=$((backup_fail + 1))
    continue
  fi

  log "${nname}: backup started (UPID: ${upid})"
  task_ids+=("${nname}|${nip}|${ntoken}|${upid}")
done <<< "$PVE_NODES"

# --- Step 5: Wait for all backups to complete ---
if [ ${#task_ids[@]} -gt 0 ] && ! $DRY_RUN; then
  log "Step 5/7: Waiting for backups to complete (max ${MAX_TASK_WAIT}s)..."
  elapsed=0

  while [ ${#task_ids[@]} -gt 0 ] && [ $elapsed -lt $MAX_TASK_WAIT ]; do
    remaining=()
    for entry in "${task_ids[@]}"; do
      IFS='|' read -r nname nip ntoken upid <<< "$entry"
      # URL-encode the UPID (replace : with %3A)
      encoded_upid=$(echo "$upid" | sed 's/:/%3A/g')
      status=$(pve_api GET "https://${nip}:8006/api2/json/nodes/${nname}/tasks/${encoded_upid}/status" "$ntoken")
      task_status=$(echo "$status" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['status'])" 2>/dev/null) || true

      case "$task_status" in
        stopped)
          exit_status=$(echo "$status" | python3 -c "import sys,json; print(json.load(sys.stdin)['data'].get('exitstatus','unknown'))" 2>/dev/null) || true
          if [ "$exit_status" = "OK" ]; then
            log "${nname}: backup completed OK"
            backup_ok=$((backup_ok + 1))
          else
            err "${nname}: backup finished with status: ${exit_status}"
            backup_fail=$((backup_fail + 1))
          fi
          ;;
        running)
          remaining+=("$entry")
          ;;
        *)
          log "${nname}: task status=${task_status}, still waiting..."
          remaining+=("$entry")
          ;;
      esac
    done
    task_ids=("${remaining[@]+"${remaining[@]}"}")

    if [ ${#task_ids[@]} -gt 0 ]; then
      sleep 30
      elapsed=$((elapsed + 30))
    fi
  done

  if [ ${#task_ids[@]} -gt 0 ]; then
    err "Timeout: ${#task_ids[@]} backups still running after ${MAX_TASK_WAIT}s"
    backup_fail=$((backup_fail + ${#task_ids[@]}))
  fi
fi

# --- Step 6: Prune old snapshots on PBS ---
log "Step 6/9: Running prune on PBS..."
if ! $DRY_RUN && [ -n "$PBS_PRUNE_JOB" ]; then
  prune_out=$(ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no root@"$PBS_IP" \
    "proxmox-backup-manager prune-job run ${PBS_PRUNE_JOB}" 2>&1) || true
  [ -n "$prune_out" ] && log "Prune output: ${prune_out}"
  log "Prune done"
fi

# --- Step 7: Garbage collection on PBS ---
log "Step 7/9: Running garbage collection on PBS..."
if ! $DRY_RUN && [ -n "$PBS_DATASTORE" ]; then
  gc_out=$(ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no root@"$PBS_IP" \
    "proxmox-backup-manager garbage-collection start ${PBS_DATASTORE}" 2>&1) || true
  [ -n "$gc_out" ] && log "GC output: ${gc_out}"
  # GC can take a few minutes — wait for it
  sleep 30
  log "GC done"
fi

# --- Step 8: Disable PBS storage ---
log "Step 8/9: Disabling storage ${PBS_STORAGE}..."
if ! $DRY_RUN; then
  pve_api PUT "https://${STORAGE_HOST}:8006/api2/json/storage/${PBS_STORAGE}" "$STORAGE_TOKEN" "disable=1" > /dev/null 2>&1
  log "Storage disabled"
fi

# --- Step 9: Shut down the backup host ---
log "Step 9/9: Shutting down the backup host..."
if ! $DRY_RUN; then
  ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no root@${PBS_HOST_IP} "shutdown -h now" 2>/dev/null || true
  log "backup host shutdown initiated"
fi

# --- Summary ---
echo ""
echo "=== PBS BACKUP SUMMARY ==="
echo "Backups OK:     ${backup_ok}"
echo "Backups FAILED: ${backup_fail}"
if $DRY_RUN; then
  echo "Mode: DRY-RUN (no actions taken)"
fi

if [ "$backup_fail" -gt 0 ]; then
  exit 1
else
  exit 0
fi
