#!/bin/bash
# pve-status — Query Proxmox node/CT status
# Usage: pve-status <node|all> [node|cts|ct <id>]
#
# Configuration comes from the environment, never from this file:
#
#   PVE_NODES="pve1|10.0.0.11|PVEAPIToken=monitor@pve!status=<uuid>
#   pve2|10.0.0.12|PVEAPIToken=monitor@pve!status=<uuid>"
#
# Put it in ~/.config/homelab-scripts/homelab-scripts.env (chmod 600) — the
# same file the other scripts read — or export it from your shell profile.
# Use a PVEAuditor token: this script only reads.

set -uo pipefail

PVE_ENV="${PVE_ENV:-${HOMELAB_SCRIPTS_ENV:-$HOME/.config/homelab-scripts/homelab-scripts.env}}"
if [ -z "${PVE_NODES:-}" ] && [ -r "$PVE_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$PVE_ENV"
  set +a
fi

if [ -z "${PVE_NODES:-}" ]; then
  echo "pve-status: PVE_NODES is not set (see the header of this script)" >&2
  exit 1
fi

node_host() {
  local want=$1
  while IFS='|' read -r name host _token; do
    [ "$name" = "$want" ] && { echo "$host"; return 0; }
  done <<< "$PVE_NODES"
  return 1
}

node_token() {
  local want=$1
  while IFS='|' read -r name _host token; do
    [ "$name" = "$want" ] && { echo "$token"; return 0; }
  done <<< "$PVE_NODES"
  return 1
}

node_names() {
  while IFS='|' read -r name _host _token; do
    [ -n "$name" ] && echo "$name"
  done <<< "$PVE_NODES"
}

pve_curl() {
  local node=$1
  local path=$2
  local host token
  host=$(node_host "$node") || { echo "Unknown node: $node" >&2; return 1; }
  token=$(node_token "$node")
  curl -sk -H "Authorization: $token" "https://$host:8006/api2/json$path"
}

node_status() {
  local node=$1
  pve_curl "$node" "/nodes/$node/status" | NODE="$node" python3 -c "
import json, sys, os
node = os.environ['NODE']
data = json.load(sys.stdin).get('data', {})
cpu = data.get('cpu', 0) * 100
mem = data.get('memory', {})
mem_used = mem.get('used', 0) / 1024**3
mem_total = mem.get('total', 0) / 1024**3
uptime_s = data.get('uptime', 0)
days = uptime_s // 86400
hours = (uptime_s % 86400) // 3600
print(f'{node}: CPU {cpu:.0f}% | RAM {mem_used:.1f}/{mem_total:.1f} GB | Uptime {days}d {hours}h')
"
}

list_cts() {
  local node=$1
  pve_curl "$node" "/nodes/$node/lxc" | python3 -c "
import json, sys
cts = json.load(sys.stdin).get('data', [])
cts.sort(key=lambda c: int(c.get('vmid', 0)))
for ct in cts:
    vmid = ct.get('vmid', '?')
    name = ct.get('name', '?')
    status = ct.get('status', '?')
    cpu = ct.get('cpu', 0) * 100
    mem = ct.get('mem', 0) / 1024**2
    maxmem = ct.get('maxmem', 0) / 1024**2
    print(f'CT {vmid:>4} {name:20} {status:8} CPU {cpu:4.0f}% MEM {mem:6.0f}/{maxmem:.0f} MB')
"
}

ct_status() {
  local node=$1
  local ctid=$2
  pve_curl "$node" "/nodes/$node/lxc/$ctid/status/current" | CTID="$ctid" python3 -c "
import json, sys, os
ctid = os.environ['CTID']
data = json.load(sys.stdin).get('data', {})
if not data:
    print('CT not found')
    sys.exit(1)
name = data.get('name', '?')
status = data.get('status', '?')
cpu = data.get('cpu', 0) * 100
mem = data.get('mem', 0) / 1024**2
maxmem = data.get('maxmem', 0) / 1024**2
disk = data.get('disk', 0) / 1024**3
maxdisk = data.get('maxdisk', 0) / 1024**3
uptime_s = data.get('uptime', 0)
days = uptime_s // 86400
hours = (uptime_s % 86400) // 3600
netin = data.get('netin', 0) / 1024**2
netout = data.get('netout', 0) / 1024**2
print(f'CT {ctid} ({name}): {status}')
print(f'  CPU: {cpu:.0f}%')
print(f'  RAM: {mem:.0f}/{maxmem:.0f} MB')
print(f'  Disk: {disk:.1f}/{maxdisk:.1f} GB')
print(f'  Net: in {netin:.0f} MB / out {netout:.0f} MB')
print(f'  Uptime: {days}d {hours}h')
"
}

case "${1:-}" in
  all)
    while read -r n; do node_status "$n"; done < <(node_names)
    ;;
  "")
    echo "Usage: pve-status <node|all> [node|cts|ct <id>]"
    echo "Nodes: $(node_names | tr '\n' ' ')"
    echo "Examples:"
    echo "  pve-status all             # Every configured node"
    echo "  pve-status pve1 cts        # List CTs on pve1"
    echo "  pve-status pve2 ct 230     # CT 230 details"
    ;;
  *)
    if ! node_host "$1" > /dev/null; then
      echo "Unknown node: $1 (configured: $(node_names | tr '\n' ' '))" >&2
      exit 1
    fi
    case "${2:-node}" in
      node) node_status "$1" ;;
      cts) list_cts "$1" ;;
      ct) ct_status "$1" "${3:?CT id required}" ;;
      *) echo "Usage: pve-status <node> [node|cts|ct <id>]" ;;
    esac
    ;;
esac
