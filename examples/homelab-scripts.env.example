# homelab-scripts — configuration
# Copy to ~/.config/homelab-scripts/homelab-scripts.env and chmod 600.
# Never commit real tokens: this file is the only place they belong.

# --- Proxmox (pve-status) ----------------------------------------------------
# One "name|host|api_token" per line. pve-status only reads: PVEAuditor is enough.
PVE_NODES="pve1|10.0.0.11|PVEAPIToken=monitor@pve!scripts=00000000-0000-0000-0000-000000000000
pve2|10.0.0.12|PVEAPIToken=monitor@pve!scripts=00000000-0000-0000-0000-000000000000"

# --- Loki (loki-query) --------------------------------------------------------
#LOKI_URL=http://10.0.0.40:3100

# --- Service checks (http-check, cert-check) ---------------------------------
#SERVICES_FILE=$HOME/.config/homelab-scripts/services.conf
#PROXY_HOST=10.0.0.10              # reverse proxy terminating TLS for cert-check
#CERT_WARN_DAYS=14
