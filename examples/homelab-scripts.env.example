# homelab-scripts — configuration
# Copy to ~/.config/homelab-scripts/homelab-scripts.env and chmod 600.
# Never commit real tokens: this file is the only place they belong.

# --- Proxmox (pve-status, pbs-backup) ----------------------------------------
# One "name|host|api_token" per line. PVEAuditor is enough for pve-status;
# pbs-backup additionally needs VM.Backup and Datastore.Allocate.
PVE_NODES="pve1|10.0.0.11|PVEAPIToken=monitor@pve!scripts=00000000-0000-0000-0000-000000000000
pve2|10.0.0.12|PVEAPIToken=monitor@pve!scripts=00000000-0000-0000-0000-000000000000"

# Node whose API toggles the PBS storage entry (defaults to the first above)
#PVE_STORAGE_NODE=pve1

# --- Proxmox Backup Server (pbs-backup) --------------------------------------
PBS_HOST_MAC=00:00:00:00:00:00     # machine woken up over the network
PBS_HOST_IP=10.0.0.50              # …and shut down at the end of the cycle
PBS_IP=10.0.0.51                   # PBS API endpoint (may be a CT on that host)
PBS_STORAGE=pbs                    # PVE storage entry pointing at PBS
#PBS_DATASTORE=backup-hdd          # datastore to garbage-collect (skipped if empty)
#PBS_PRUNE_JOB=weekly-prune        # prune job to run (skipped if empty)
#BACKUP_MODE=snapshot
#COMPRESS=zstd

# --- Loki (loki-query) --------------------------------------------------------
#LOKI_URL=http://10.0.0.40:3100

# --- Service checks (http-check, cert-check) ---------------------------------
#SERVICES_FILE=$HOME/.config/homelab-scripts/services.conf
#PROXY_HOST=10.0.0.10              # reverse proxy terminating TLS for cert-check
#CERT_WARN_DAYS=14
