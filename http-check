#!/bin/bash
# http-check — Check HTTP status code of services
# Usage: http-check <service|url> [service2 ...] | http-check all
#
# Services are read from a config file (default:
# ~/.config/homelab-scripts/services.conf), one "name|url" per line:
#
#   forgejo|https://forge.example.lab
#   dns|http://10.0.0.10:5380
#
# See examples/services.conf.example.

SERVICES_FILE="${SERVICES_FILE:-$HOME/.config/homelab-scripts/services.conf}"

KNOWN_SERVICES=()
declare -A SERVICE_URLS=()
if [ -r "$SERVICES_FILE" ]; then
  while IFS='|' read -r name url; do
    [ -z "${name:-}" ] && continue
    [[ "$name" == \#* ]] && continue
    [ -z "${url:-}" ] && continue
    KNOWN_SERVICES+=("$name")
    SERVICE_URLS[$name]="$url"
  done < "$SERVICES_FILE"
fi

check_url() {
  local name=$1
  local url=$2
  local code
  code=$(curl -sk -o /dev/null -w "%{http_code}" --connect-timeout 5 --max-time 10 "$url" 2>/dev/null)
  local exit_code=$?
  if [ $exit_code -ne 0 ]; then
    echo "$name: FAIL (connection error)"
  elif [ "$code" -ge 200 ] 2>/dev/null && [ "$code" -lt 400 ]; then
    echo "$name: OK ($code)"
  elif [ "$code" -ge 400 ] 2>/dev/null && [ "$code" -lt 500 ]; then
    echo "$name: WARN ($code)"
  else
    echo "$name: ERROR ($code)"
  fi
}

if [ $# -eq 0 ]; then
  echo "Usage: http-check <service|url> [service2 ...] | http-check all"
  echo "Config:   $SERVICES_FILE"
  echo "Services: ${KNOWN_SERVICES[*]:-none configured}"
  exit 1
fi

if [ "$1" = "all" ] && [ ${#KNOWN_SERVICES[@]} -eq 0 ]; then
  echo "http-check: no service found in $SERVICES_FILE" >&2
  exit 1
fi

if [ "$1" = "all" ]; then
  for svc in "${KNOWN_SERVICES[@]}"; do
    check_url "$svc" "${SERVICE_URLS[$svc]}"
  done
  exit 0
fi

for arg in "$@"; do
  if [[ -n "${SERVICE_URLS[$arg]}" ]]; then
    check_url "$arg" "${SERVICE_URLS[$arg]}"
  elif [[ "$arg" == http* ]]; then
    check_url "$arg" "$arg"
  else
    echo "$arg: unknown service (try: http-check all)"
  fi
done
